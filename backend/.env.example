# Copy to .env and fill in. See CLAUDE.md — defaults (Gemini Flash, Google
# Places, Tavily) must not change without checking with the project owner.

APP_ENV=development
CORS_ORIGINS=*

SQLITE_PATH=./data/cache.db
EMERGENCY_NUMBERS_PATH=./data/emergency_numbers.json

GOOGLE_PLACES_API_KEY=
WEATHER_API_KEY=
WEATHER_PROVIDER=openweathermap

TAVILY_API_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LLM_FREE_DAILY_LIMIT_PER_DEVICE=30
GEMINI_FREE_TIER_DAILY_LIMIT=1500

NEARBY_PLACES_RADIUS_KM=15
LOCATION_ID_PRECISION=3
HTTP_TIMEOUT_SECONDS=15
